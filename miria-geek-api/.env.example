# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────

# Perfil ativo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Servidor
SERVER_PORT=8080

# Banco de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/miria_geek_dev
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=miria-geek-dev

# JWT / OAuth2 (Keycloak ou outro provider)
JWT_ISSUER_URI=http://localhost:8180/realms/miria-geek

# E-mail (dev: Mailhog/Mailpit | prod: SMTP real)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# MinIO (armazenamento de imagens)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_PRODUCTS=miria-products
MINIO_PUBLIC_URL=http://localhost:9000
